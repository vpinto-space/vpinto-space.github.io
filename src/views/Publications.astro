---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHead from '../components/SectionHead.astro';
import PubList from '../components/PubList.astro';
import Pager from '../components/Pager.astro';
import { ui, routes, type Lang } from '../lib/i18n';
import { site } from '../lib/data';
import { getPublications } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const pubs = await getPublications();
const articles = pubs.filter((p) => p.type === 'article');
const other = pubs.filter((p) => p.type === 'other');
---
<Layout lang={lang} title={t.pubs.title} route="publications" description={t.pubs.lead}>
  <PageHeader eyebrow={t.pubs.eyebrow} title={t.pubs.title} lead={t.pubs.lead} back={{ href: `${routes.home[lang]}#publications`, label: t.backHome }}>
    <p class="meta header-links">{t.pubs.profiles}: {site.profiles.slice(0, 3).map((p, i) => <>{i > 0 && ' · '}<a href={p.url} target="_blank" rel="noopener">{p.label}</a></>)}</p>
  </PageHeader>

  <section class="band">
    <div class="wrap">
      <SectionHead title={t.pubs.articles} />
      <PubList pubs={articles} lang={lang} />
    </div>
  </section>

  <section class="band band-alt">
    <div class="wrap">
      <SectionHead title={t.pubs.other} />
      <PubList pubs={other} lang={lang} />
    </div>
  </section>
  <Pager lang={lang} current="publications" />
</Layout>
