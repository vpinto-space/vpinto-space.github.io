---
import '../styles/global.css';
const lang = Astro.currentLocale === 'en' ? 'en' : 'es';
const { title, description } = Astro.props;
const p = (path) => lang === 'es' ? path : `/en${path}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Victor Pinto</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={`https://victorapinto.com${lang === 'en' ? '/en/' : '/'}`} />
  </head>
  <body>
    <header>
      <nav>
        <a href={p('/')} class="brand">Victor A. Pinto Abarzúa</a>
        <div style="display:flex;gap:1.3rem;align-items:center;flex-wrap:wrap">
          <a href={p('/about')}>{lang === 'en' ? 'About' : 'Sobre mí'}</a>
          <a href={p('/research')}>{lang === 'en' ? 'Research' : 'Investigación'}</a>
          <a href={p('/publications')}>{lang === 'en' ? 'Publications' : 'Publicaciones'}</a>
          <a href={p('/teaching')}>{lang === 'en' ? 'Teaching' : 'Docencia'}</a>
          <a href={p('/service')}>{lang === 'en' ? 'Service' : 'Servicio'}</a>
          <a href={p('/media')}>{lang === 'en' ? 'Media' : 'Medios'}</a>
          <a href="https://heliousach.github.io" target="_blank" rel="noopener" class="badge badge-accent">{lang === 'en' ? 'Research Group →' : 'Grupo de investigación →'}</a>
          <span class="lang-toggle">
            {lang === 'es'
              ? <a href="/en/" style="color:var(--accent)">EN</a>
              : <a href="/" style="color:var(--accent)">ES</a>
            }
          </span>
        </div>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <div style="margin-bottom:1rem">
        <a href="mailto:victor.pinto@usach.cl">Email</a>
        <a href="https://scholar.google.com/citations?user=nEqGWqoAAAAJ" target="_blank" rel="noopener">Scholar</a>
        <a href="https://orcid.org/0000-0003-1210-167X" target="_blank" rel="noopener">ORCID</a>
        <a href="https://github.com/vpinto-space" target="_blank" rel="noopener">GitHub</a>
        <a href="https://twitter.com/vpintoa" target="_blank" rel="noopener">X</a>
        <a href="https://www.researchgate.net/profile/Victor-Pinto-9" target="_blank" rel="noopener">ResearchGate</a>
      </div>
      <p style="font-size:0.8rem;color:var(--text-muted)">&copy; {new Date().getFullYear()} Victor A. Pinto Abarzúa</p>
    </footer>
  </body>
</html>