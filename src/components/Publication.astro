---
import { citationHtml } from '../lib/publications';

interface Props {
  pub: { year: number; citation: string; doi?: string; inPress?: boolean };
  lang: 'es' | 'en';
  showYear?: boolean;
}
const { pub, lang, showYear = false } = Astro.props;
const inPress = lang === 'en' ? 'In press' : 'En prensa';
---
<div class="card">
  <p>
    <Fragment set:html={citationHtml(pub.citation)} />
    {showYear && ` (${pub.year})`}
    {pub.inPress && <> <span class="badge">{inPress}</span></>}
    {pub.doi && <> <a href={pub.doi} target="_blank" rel="noopener">DOI</a></>}
  </p>
</div>
