---
import Layout from '../layouts/Layout.astro';
import Publication from '../components/Publication.astro';
import { getPublications } from '../lib/publications';

const recent = (await getPublications()).filter((p) => p.type === 'article').slice(0, 3);
---

<Layout title="Inicio" description="Victor A. Pinto Abarzúa — Físico espacial, Profesor Asistente en USACH. Investigador en cinturones de radiación, clima espacial y machine learning.">

<section>
  <p class="lead">
    Soy <strong>Profesor Asistente</strong> en el Departamento de Física de la <strong>Universidad de Santiago de Chile (USACH)</strong>, donde soy Subdirector de Docencia y co-dirijo, junto a la Dra. Marina Stepanova, el grupo de investigación <a href="https://heliousach.github.io" target="_blank">HelioFísica y Clima Espacial</a>. Mi investigación se centra en la dinámica de los cinturones de radiación de la Tierra, las ondas ULF y el uso de machine learning para la predicción del clima espacial.
  </p>
</section>

<h2>Publicaciones recientes</h2>
<div class="section">
  {recent.map((p) => <Publication pub={p} lang="es" showYear />)}
  <p class="more-link"><a href="/publications">Ver todas las publicaciones →</a></p>
</div>

<h2>Financiamiento activo</h2>
<div class="section">
  <div class="card">
    <p><strong>FONDECYT de Iniciación 2025</strong> (Investigador responsable) — El rol de ondas ULF electromagnéticas en la dinámica de partículas cargadas atrapadas en los cinturones de radiación de la Tierra. ANID, 2025-2028.</p>
  </div>
  <div class="card">
    <p><strong>FONDEQUIP 2023</strong> (Director) — Plataforma de cómputo de alto rendimiento (HPC) del Departamento de Física. ANID, 2023-.</p>
  </div>
  <div class="card">
    <p><strong>FONDEF IDEA I+D</strong> (Investigador principal, USACH) — Plataforma piloto de clima espacial para Chile, liderada por la Universidad Adventista de Chile. ANID, 2025-2027.</p>
  </div>
  <p class="more-link"><a href="/research">Ver todos los proyectos →</a></p>
</div>

<h2>Apariciones recientes en medios</h2>
<div class="section">
  <div class="card">
    <p><span class="badge">Abr 2026</span> <strong>Canal 13 TV, Radio USACH, ivoox, YouTube USACH</strong> — Cobertura del lanzamiento Artemis II y sobrevuelo lunar</p>
  </div>
  <div class="card">
    <p><span class="badge">Dic 2025</span> <strong>VRIIC, Diario Usach, Mundo Online, Crónica Digital</strong> — Lanzamiento de la plataforma FONDEF de clima espacial</p>
  </div>
  <div class="card">
    <p><span class="badge">2025</span> <strong>Foro Ciudadano podcast, FIDAE Space Summit</strong> — Centro Espacial Nacional y estado de la exploración espacial en Chile</p>
  </div>
  <p class="more-link"><a href="/media">Ver todas las apariciones →</a></p>
</div>

</Layout>