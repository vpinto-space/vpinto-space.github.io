---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { ui, routes, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---
<Layout lang={lang} title={t.notFound.title} noindex>
  <PageHeader title={t.notFound.title} lead={t.notFound.text}>
    <p><a class="btn btn-primary" href={routes.home[lang]}>{t.notFound.home}</a></p>
  </PageHeader>
</Layout>
