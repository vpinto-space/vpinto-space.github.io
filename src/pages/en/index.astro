---
import Layout from '../../layouts/Layout.astro';
import Publication from '../../components/Publication.astro';
import { getPublications } from '../../lib/publications';

const recent = (await getPublications()).filter((p) => p.type === 'article').slice(0, 3);
---

<Layout title="Home" description="Victor A. Pinto Abarzúa — Space physicist, Assistant Professor at USACH. Researcher in radiation belts, space weather, and machine learning.">

<section>
  <p class="lead">
    I am an <strong>Assistant Professor</strong> at the Department of Physics, <strong>Universidad de Santiago de Chile (USACH)</strong>, where I serve as Associate Chair for Teaching and co-lead, with Prof. Marina Stepanova, the <a href="https://heliousach.github.io" target="_blank">HelioFísica and Space Weather Research Group</a>. My research focuses on the dynamics of Earth's radiation belts, ULF waves, and the use of machine learning for space weather prediction.
  </p>
</section>

<h2>Recent publications</h2>
<div class="section">
  {recent.map((p) => <Publication pub={p} lang="en" showYear />)}
  <p class="more-link"><a href="/en/publications">View all publications →</a></p>
</div>

<h2>Active funding</h2>
<div class="section">
  <div class="card">
    <p><strong>FONDECYT Initiation 2025</strong> (PI) — The role of electromagnetic ULF waves on the dynamics of trapped charged particles in the Earth's radiation belts. ANID, 2025-2028.</p>
  </div>
  <div class="card">
    <p><strong>FONDEQUIP 2023</strong> (Director) — High-performance computing (HPC) platform at the Department of Physics. ANID, 2023-.</p>
  </div>
  <div class="card">
    <p><strong>FONDEF IDEA I+D</strong> (Principal investigator, USACH) — Pilot space weather platform for Chile, led by Universidad Adventista de Chile. ANID, 2025-2027.</p>
  </div>
  <p class="more-link"><a href="/en/research">View all projects →</a></p>
</div>

<h2>Recent media appearances</h2>
<div class="section">
  <div class="card">
    <p><span class="badge">Apr 2026</span> <strong>Canal 13 TV, Radio USACH, ivoox, YouTube USACH</strong> — Artemis II launch and lunar flyby coverage</p>
  </div>
  <div class="card">
    <p><span class="badge">Dec 2025</span> <strong>VRIIC, Diario Usach, Mundo Online, Crónica Digital</strong> — FONDEF space weather platform launch</p>
  </div>
  <div class="card">
    <p><span class="badge">2025</span> <strong>Foro Ciudadano podcast, FIDAE Space Summit</strong> — National Space Center and state of space exploration in Chile</p>
  </div>
  <p class="more-link"><a href="/en/media">View all appearances →</a></p>
</div>

</Layout>